---
/**
 * ATS-friendly CV: single column, real text, standard headings,
 * no tables / icons / columns. Used by the web page and the PDF.
 */
import { cv, formatPeriod } from '@/data/cv';
import { site } from '@/data/site';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const h = lang === 'es'
  ? { summary: 'Perfil profesional', experience: 'Experiencia', skills: 'Habilidades', education: 'Educación', languages: 'Idiomas' }
  : { summary: 'Summary', experience: 'Experience', skills: 'Skills', education: 'Education', languages: 'Languages' };

const strip = (u: string) => u.replace(/^https?:\/\//, '');
const contact = [
  site.location,
  site.email,
  site.links.linkedin && strip(site.links.linkedin),
  site.links.github && strip(site.links.github),
  site.domain,
].filter(Boolean) as string[];
---

<div class="cv" lang={lang}>
  <header>
    <h1>{site.name}</h1>
    <p class="headline">{cv.headline[lang]}</p>
    <p class="contact">{contact.join(' | ')}</p>
  </header>

  <section>
    <h2>{h.summary}</h2>
    <p>{cv.summary[lang]}</p>
  </section>

  <section>
    <h2>{h.experience}</h2>
    {
      cv.experience.map((job) => (
        <div class="job">
          <h3>
            {job.role[lang]} — {job.company}
          </h3>
          <p class="when">
            {formatPeriod(job.start, job.end, lang)} | {job.place[lang]}
          </p>
          {job.bullets.length > 0 && (
            <ul>
              {job.bullets.map((b) => (
                <li>{b[lang]}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </section>

  <section>
    <h2>{h.skills}</h2>
    <ul class="plain">
      {cv.skills.map((s) => <li><strong>{s.label[lang]}:</strong> {s.items.join(', ')}</li>)}
    </ul>
  </section>

  <section>
    <h2>{h.education}</h2>
    <ul class="plain">
      {cv.education.map((e) => <li><strong>{e.title[lang]}</strong> — {e.org} | {e.period}</li>)}
    </ul>
  </section>

  <section>
    <h2>{h.languages}</h2>
    <p>{cv.languages.map((l) => `${l.name[lang]} (${l.level[lang]})`).join(', ')}</p>
  </section>
</div>

<style>
  .cv {
    font-family: Arial, 'Liberation Sans', Helvetica, sans-serif;
    font-size: 10.5pt;
    line-height: 1.4;
    color: #111;
    background: #fff;
  }

  h1 {
    font-family: inherit;
    font-size: 20pt;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
    margin: 0;
  }

  .headline {
    font-size: 12pt;
    font-weight: 700;
    margin-top: 2pt;
  }

  .contact {
    margin-top: 4pt;
    font-size: 9.5pt;
  }

  h2 {
    font-family: inherit;
    font-size: 11.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
    margin: 14pt 0 6pt;
    padding-bottom: 2pt;
    border-bottom: 1px solid #111;
  }

  h3 {
    font-family: inherit;
    font-size: 10.5pt;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 0;
  }

  .job + .job {
    margin-top: 9pt;
  }

  .when {
    font-size: 9.5pt;
    color: #333;
    margin: 1pt 0 3pt;
  }

  ul {
    margin: 0;
    padding-left: 14pt;
  }

  li + li {
    margin-top: 2pt;
  }

  ul.plain {
    list-style: none;
    padding-left: 0;
  }

  section {
    break-inside: auto;
  }

  .job {
    break-inside: avoid;
  }
</style>
