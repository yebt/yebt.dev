---
/** Schematic arrows: a node at the tail, a hairline shaft, an open head. */
interface Props {
  name: 'right' | 'left' | 'up-right' | 'down' | 'up';
  class?: string;
}
const { name, class: className } = Astro.props;

const paths: Record<Props['name'], { node: [number, number]; d: string }> = {
  right: { node: [1, 7], d: 'M4.5 8H14M10.5 4.5 14 8l-3.5 3.5' },
  left: { node: [13, 7], d: 'M11.5 8H2M5.5 4.5 2 8l3.5 3.5' },
  'up-right': { node: [1, 13], d: 'M4.5 11.5 13 3M7 3h6v6' },
  down: { node: [7, 1], d: 'M8 4.5V12M4.5 8.5 8 12l3.5-3.5M3 15h10' },
  up: { node: [7, 13], d: 'M8 11.5V2M4.5 5.5 8 2l3.5 3.5' },
};
const p = paths[name];
---

<svg class:list={['icon', `icon-${name}`, className]} viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false">
  <rect x={p.node[0]} y={p.node[1]} width="2" height="2" fill="currentColor"></rect>
  <path d={p.d} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"></path>
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: -0.14em;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  :global(a:hover) > .icon-right,
  :global(button:hover) > .icon-right {
    transform: translateX(3px);
  }

  :global(a:hover) > .icon-left {
    transform: translateX(-3px);
  }

  :global(a:hover) > .icon-up-right {
    transform: translate(2px, -2px);
  }

  :global(a:hover) > .icon-down {
    transform: translateY(2px);
  }

  :global(a:hover) > .icon-up {
    transform: translateY(-2px);
  }
</style>
