---
/** Decorative hero composition — circle, quartered halftone disc, red square, drafting lines. */
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label = 'SYS.ARCH — REV.04' } = Astro.props;
const id = `s${Math.random().toString(36).slice(2, 7)}`;
---

<svg class:list={['schematic', className]} viewBox="0 0 420 520" role="img" aria-hidden="true">
  <defs>
    <pattern id={`${id}-dots`} width="4" height="4" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r=".9" fill="var(--fg)"></circle>
    </pattern>
    <pattern id={`${id}-dots2`} width="3" height="3" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r=".55" fill="var(--fg)"></circle>
    </pattern>
    <filter id={`${id}-rough`}>
      <feTurbulence type="fractalNoise" baseFrequency=".8" numOctaves="2" result="n"></feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="2.4"></feDisplacementMap>
    </filter>
    <clipPath id={`${id}-disc`}><circle cx="200" cy="220" r="86"></circle></clipPath>
  </defs>

  <!-- drafting grid -->
  <g stroke="var(--line-strong)" stroke-width=".6" fill="none">
    <path d="M40 0v520M120 40v380M200 0v520M330 30v420M380 0v520"></path>
    <path d="M0 134h420M40 306h360M0 420h420"></path>
    <rect x="120" y="134" width="210" height="172"></rect>
  </g>

  <!-- orbit -->
  <circle class="orbit" cx="200" cy="220" r="168" fill="none" stroke="var(--accent)" stroke-width=".9" stroke-dasharray="2 5"></circle>
  <circle cx="200" cy="220" r="150" fill="none" stroke="var(--line-strong)" stroke-width=".6"></circle>

  <!-- quartered halftone disc -->
  <g clip-path={`url(#${id}-disc)`} filter={`url(#${id}-rough)`}>
    <rect x="100" y="120" width="100" height="100" fill={`url(#${id}-dots)`} opacity=".85"></rect>
    <rect x="200" y="120" width="100" height="100" fill="var(--fg-2)" opacity=".75"></rect>
    <rect x="200" y="120" width="100" height="100" fill={`url(#${id}-dots2)`} opacity=".5"></rect>
    <rect x="100" y="220" width="100" height="100" fill={`url(#${id}-dots2)`} opacity=".55"></rect>
    <rect x="200" y="220" width="100" height="100" fill={`url(#${id}-dots)`} opacity=".35"></rect>
  </g>

  <!-- crosshair -->
  <path d="M168 220h32v34" stroke="var(--accent)" stroke-width="2.4" fill="none"></path>

  <!-- red block -->
  <rect class="block" x="300" y="226" width="84" height="84" fill="var(--accent)"></rect>

  <!-- vertical red cut -->
  <path d="M152 300v220" stroke="var(--accent)" stroke-width="1.2"></path>

  <!-- annotations -->
  <g font-family="JetBrains Mono, monospace" font-size="7.5" fill="var(--muted)" letter-spacing=".6">
    <text x="44" y="16" fill="var(--accent)">{label}</text>
    <text x="336" y="48">N 04°05′</text>
    <text x="336" y="58">W 76°11′</text>
    <text x="44" y="300">[ api ]</text>
    <text x="44" y="312">[ queue ]</text>
    <text x="44" y="324">[ store ]</text>
    <text x="300" y="322" fill="var(--accent)">cache.hit 0.94</text>
    <text x="206" y="432">p95 ≤ 1.1s</text>
    <text x="206" y="444">deploy 5m</text>
  </g>
  <rect x="346" y="370" width="5" height="9" fill="var(--accent)"></rect>
  <rect x="354" y="370" width="5" height="9" fill="var(--accent)"></rect>
</svg>

<style>
  .schematic {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .orbit {
    transform-origin: 200px 220px;
    animation: spin 90s linear infinite;
  }

  .block {
    mix-blend-mode: normal;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
