---
import type { CollectionEntry } from 'astro:content';
import Schematic from './Schematic.astro';

interface Props {
  video: NonNullable<CollectionEntry<'garden'>['data']['video']>;
  title: string;
  pendingLabel: string;
}
const { video, title, pendingLabel } = Astro.props;
---

<figure class="video">
  <div class="frame">
    {
      video.provider === 'youtube' && (
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${video.id}?rel=0`}
          title={title}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        />
      )
    }
    {
      video.provider === 'file' && (
        <video controls preload="metadata" poster={video.poster} playsinline>
          <source src={video.src} />
        </video>
      )
    }
    {
      video.provider === 'pending' && (
        <div class="pending">
          <Schematic class="pending-art" label="REC — STANDBY" />
          <span class="pending-label mono">
            <span class="rec" aria-hidden="true" /> {pendingLabel}
          </span>
        </div>
      )
    }
  </div>
  <figcaption class="label">
    <span>▶ {title}</span>
    <span>{video.provider === 'youtube' ? 'youtube' : video.provider === 'file' ? 'video' : '—'}</span>
  </figcaption>
</figure>

<style>
  .video {
    margin: 0;
    border: 1px solid var(--line-strong);
    background: var(--panel);
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg);
  }

  .frame :global(iframe),
  .frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .pending :global(.pending-art) {
    position: absolute;
    width: 46%;
    opacity: 0.55;
  }

  .pending-label {
    position: relative;
    font-size: 0.8rem;
    padding: 8px 14px;
    background: var(--bg);
    border: 1px solid var(--line-strong);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .rec {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 1.4s steps(2) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border-top: 1px solid var(--line-strong);
  }
</style>
