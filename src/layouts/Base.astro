---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { getLangFromUrl, swapLang, useTranslations } from '@/i18n/utils';
import { langs } from '@/i18n/ui';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('meta.description'), type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${t('hero.kicker')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(swapLang(Astro.url, l), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(swapLang(Astro.url, 'en'), Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Garden`} href={`/${lang}/garden/rss.xml`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=JetBrains+Mono:wght@400;500;700&display=swap"
    />

    <script is:inline>
      (function () {
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') theme = saved;
          else if (window.matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
        } catch (e) {}
        var root = document.documentElement;
        root.dataset.theme = theme;
        root.classList.add('js');
        try {
          if (!sessionStorage.getItem('booted')) {
            root.classList.add('boot');
            sessionStorage.setItem('booted', '1');
          }
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <div class="boot-scan" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Power things on as they enter the viewport: [data-boot] blocks and herbarium specimens.
      const targets = document.querySelectorAll('[data-boot], .botanical');
      const on = (el: Element) => el.classList.add('is-on');
      if (!('IntersectionObserver' in window)) targets.forEach(on);
      else {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                on(e.target);
                io.unobserve(e.target);
              }
            }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
