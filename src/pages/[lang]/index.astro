---
import Base from '@/layouts/Base.astro';
import Schematic from '@/components/Schematic.astro';
import Window from '@/components/Window.astro';
import CodeLines from '@/components/CodeLines.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import GardenRow from '@/components/GardenRow.astro';
import { cv, impact, now, principles } from '@/data/cv';
import { site } from '@/data/site';
import type { Lang } from '@/i18n/ui';
import { getLocalized, getStaticLangPaths, path, useTranslations } from '@/i18n/utils';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const projects = (await getLocalized('projects', lang))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const garden = (await getLocalized('garden', lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const code = [
  `const engineer = {`,
  `  name: 'Yahir Eduardo Bravo Tafur',`,
  `  focus: ['backend', 'software architecture'],`,
  `  leading: 3, // ${lang === 'es' ? 'proyectos en paralelo' : 'projects in parallel'}`,
  `  deploy: '30min -> 5min',`,
  `  stack: ['PHP/Laravel', 'Node/Bun', 'PostgreSQL', 'Docker'],`,
  `  principles: ['SOLID', 'clean boundaries', 'measure first'],`,
  `  based: 'Colombia · UTC-5',`,
  `};`,
];
---

<Base>
  <!-- ============ HERO ============ -->
  <section class="hero wrap">
    <div class="hero-meta">
      <span class="label accent">{t('hero.kicker')}</span>
      <span class="label status"><span class="dot" aria-hidden="true"></span>{t('hero.available')}</span>
    </div>

    <p class="hero-micro label" aria-hidden="true">
      {(lang === 'es' ? 'diseño · construyo · despliego · mido · documento · repito' : 'design · build · deploy · measure · document · repeat').split(' · ').map((w) => <span>{w}</span>)}
    </p>

    <h1 class="hero-title">
      <span class="ln-a">{t('hero.title.a')}</span>
      <span class="ln-b wide">{t('hero.title.b')}</span>
      <span class="ln-c">{t('hero.title.c')}</span>
    </h1>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="lede">{t('hero.lede')}</p>
        <div class="ctas">
          <a class="btn btn--accent" href={site.cv[lang]} download>
            <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1v10M3.5 6.5 8 11l4.5-4.5M2 14.5h12" stroke="currentColor" stroke-width="1.5" fill="none"></path></svg>
            {t('hero.cta.cv')}
          </a>
          <a class="btn" href={path(lang, 'projects')}>{t('hero.cta.projects')} →</a>
        </div>
        <Window title="engineer.ts" class="hero-code">
          <CodeLines lines={code} />
        </Window>
      </div>
      <div class="hero-art">
        <Schematic />
      </div>
    </div>
  </section>

  <!-- ============ IMPACT ============ -->
  <section class="section wrap" aria-labelledby="impact">
    <SectionHead index="01" title={t('impact.title')} id="impact" />
    <ul class="impact">
      {
        impact.map((m) => (
          <li>
            <span class="num wide">
              {m.value}
              <small>{m.unit}</small>
            </span>
            <span class="label">{m.label[lang]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ FEATURED PROJECTS ============ -->
  <section class="section wrap" aria-labelledby="featured">
    <SectionHead index="02" title={t('featured.title')} id="featured" href={path(lang, 'projects')} linkLabel={t('featured.all')} />
    <div class="cards">
      {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
  </section>

  <!-- ============ NOW + PRINCIPLES ============ -->
  <section class="section wrap split" aria-labelledby="principles">
    <div>
      <SectionHead index="03" title={t('now.title')} />
      <ol class="now">
        {now[lang].map((item, i) => <li><span class="label accent">{String(i + 1).padStart(2, '0')}</span><span>{item}</span></li>)}
      </ol>
    </div>
    <div>
      <SectionHead index="04" title={t('principles.title')} id="principles" />
      <dl class="principles">
        {
          principles.map((p) => (
            <div>
              <dt>{p.title[lang]}</dt>
              <dd>{p.body[lang]}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ============ GARDEN ============ -->
  <section class="section wrap" aria-labelledby="garden">
    <SectionHead index="05" title={t('garden.latest')} id="garden" href={path(lang, 'garden')} linkLabel={t('garden.all')} />
    {garden.length > 0 ? (
      <ul class="garden-list">{garden.map((g) => <GardenRow entry={g} lang={lang} />)}</ul>
    ) : (
      <p class="label">{t('garden.empty')}</p>
    )}
  </section>

  <!-- ============ STACK ============ -->
  <section class="section wrap" aria-labelledby="stack">
    <SectionHead index="06" title={t('stack.title')} id="stack" />
    <dl class="stack">
      {
        cv.skills.map((s) => (
          <div>
            <dt class="label">{s.label[lang]}</dt>
            <dd>
              <ul class="tags">{s.items.map((i) => <li class="tag">{i}</li>)}</ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section wrap contact" aria-labelledby="contact">
    <SectionHead index="07" title={t('contact.title')} id="contact" />
    <p class="contact-lede">{t('contact.lede')}</p>
    <div class="ctas">
      {site.email && <a class="btn btn--accent" href={`mailto:${site.email}`}>{site.email}</a>}
      {site.links.linkedin && <a class="btn" href={site.links.linkedin} rel="me noopener">LinkedIn →</a>}
      <a class="btn" href={site.links.github} rel="me noopener">GitHub →</a>
      <a class="btn" href={path(lang, 'cv')}>{t('nav.cv')} →</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(28px, 5vw, 56px);
    padding-bottom: clamp(48px, 8vw, 96px);
    position: relative;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .hero-micro {
    display: flex;
    justify-content: space-between;
    margin-top: clamp(28px, 6vw, 72px);
    font-size: 0.625rem;
    gap: 8px;
    overflow: hidden;
  }

  .hero-title {
    margin-top: 10px;
    display: flex;
    flex-direction: column;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  .ln-a,
  .ln-c {
    font-size: clamp(1.6rem, 4.6vw, 3.6rem);
    font-weight: 500;
    font-variation-settings: 'wdth' 85;
  }

  .ln-a {
    color: var(--fg-2);
  }

  .ln-b {
    font-size: clamp(3.6rem, 16.5vw, 13.5rem);
    font-weight: 800;
    color: var(--accent);
    margin-block: 0.04em 0.08em;
    margin-left: -0.04em;
  }

  .ln-c {
    align-self: flex-end;
    text-align: right;
    max-width: 18ch;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .lede {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--fg-2);
    max-width: 58ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero-copy :global(.hero-code) {
    margin-top: 36px;
  }

  .hero-art {
    position: relative;
    max-width: 460px;
    justify-self: end;
    width: 100%;
  }

  /* impact */
  .impact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-left: 1px solid var(--line);
  }

  .impact li {
    padding: 18px 20px 22px;
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .num small {
    font-size: 0.35em;
    color: var(--accent);
    margin-left: 4px;
    letter-spacing: 0;
  }

  /* cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }

  /* now + principles */
  .split {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(32px, 6vw, 96px);
  }

  .now {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .now li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 8px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-2);
  }

  .principles {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .principles div {
    background: var(--bg);
    padding: 20px;
  }

  .principles div:first-child {
    grid-column: span 2;
  }

  .principles dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 8px;
  }

  .principles dt::before {
    content: '■ ';
    color: var(--accent);
    font-size: 0.7em;
    vertical-align: 0.15em;
  }

  .principles dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-2);
    line-height: 1.65;
  }

  /* garden */
  .garden-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
  }

  /* stack */
  .stack {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .stack div {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px dashed var(--line);
    align-items: center;
  }

  .stack dd {
    margin: 0;
  }

  .contact-lede {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3.4vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;
    max-width: 26ch;
    letter-spacing: -0.015em;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .split {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-art {
      justify-self: center;
      max-width: 380px;
      order: -1;
    }
    .impact {
      grid-template-columns: 1fr 1fr;
    }
    .impact li {
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .hero-micro span:nth-child(n + 4) {
      display: none;
    }
    .principles {
      grid-template-columns: 1fr;
    }
    .principles div:first-child {
      grid-column: auto;
    }
    .stack div {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .ln-c {
      align-self: flex-start;
      text-align: left;
    }
  }
</style>
